generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  jobTitle             String?
  company              String?
  password             String?
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean          @default(false)
  // ── Stripe billing ──────────────────────────────────────────────────────────
  stripeCustomerId         String?          @unique
  stripeSubscriptionId     String?          @unique
  stripePriceId            String?
  stripeCurrentPeriodEnd   DateTime?
  plan                     String           @default("FREE")
  language                 String           @default("en")
  createdAt            DateTime         @default(now())
  accounts        Account[]
  sessions        Session[]
  analysisResults AnalysisResult[]
  tasks           Task[]
  leads           Lead[]
}

model Lead {
  id              String   @id @default(cuid())
  url             String
  companyName     String?
  identifiedFlaws Json
  coldEmailDraft  String   @db.Text
  status          String   @default("DRAFT")
  userId          String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  status          String   @default("TODO")
  category        String
  priority        String
  userId          String
  solution        String?  @db.Text
  websiteContext  String?  @db.Text
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalysisResult {
  id        String   @id @default(cuid())
  url       String
  topics    String[]
  sentiment String
  summary   String?  @db.Text
  keywords  String[]
  userId    String?
  createdAt DateTime @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── 24h cache fields — let repeat analyses of the same URL skip scrape + AI calls ──
  language         String  @default("en")
  sentimentScore   Int?
  category         String?
  designStyle      String?
  scrapedText      String? @db.Text
  boardOfDirectors Json?
  cachedTasks      Json?
  aiProvider       String  @default("openai")

  @@index([userId])
  @@index([url, language, createdAt])
}

model EmailFeedback {
  id           String   @id @default(cuid())
  leadId       String?
  url          String
  emailDraft   String   @db.Text
  editedDraft  String?  @db.Text
  rating       String   // "good" | "bad"
  userId       String
  createdAt    DateTime @default(now())

  @@index([userId])
}

model EmailVerificationCode {
  id      String   @id @default(cuid())
  email   String
  code    String
  expires DateTime

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
